generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  CAREGIVER
  PHARMACY
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  DISABLED
}

enum MedicineSource {
  MANUAL
  SCANNER
  DOCTOR_PRESCRIBED
}

enum MedicineFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  AS_NEEDED
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MedicineReviewStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum MedicineReviewRequestType {
  ADD
  DELETE
}

enum MedicineReviewRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum DoseLogStatus {
  PENDING
  TAKEN
  MISSED
  SNOOZED
}

enum VitalStatus {
  STABLE
  WARNING
  CRITICAL
}

enum VitalSource {
  HEALTH_CONNECT
  SIMULATED
  MANUAL
}

enum MedicineOrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum SafetyAlertStatus {
  ACTIVE
  CANCELLED
  ESCALATED
  RESOLVED
}

enum ConsultationType {
  EMERGENCY
  MANUAL
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MedicineSafetyLevel {
  STANDARD
  DOCTOR_REVIEW_RECOMMENDED
}

enum PatientDoctorAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum DoctorAssignmentType {
  PRIMARY
  SPECIALIST
}

enum PrescriptionSource {
  MANUAL
  SCANNED
}

model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  passwordHash    String
  role            UserRole
  accountStatus   AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)

  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?

  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  medicines        Medicine[]
  medicineDoseLogs MedicineDoseLog[]
  vitalReadings    PatientVitalReading[]
  doctorNotes      PatientDoctorNote[]
  medicineOrders   MedicineOrder[]

  patientSafetyAlerts SafetyAlert[] @relation("PatientSafetyAlerts")
  doctorSafetyAlerts  SafetyAlert[] @relation("DoctorSafetyAlerts")

  patientConsultations     Consultation[]            @relation("PatientConsultations")
  doctorConsultations      Consultation[]            @relation("DoctorConsultations")
  patientDoctorAssignments PatientDoctorAssignment[] @relation("PatientDoctorAssignments")
  doctorPatientAssignments PatientDoctorAssignment[] @relation("DoctorPatientAssignments")

  medicineReviewAssignments MedicineReminder[] @relation("MedicineReviewDoctor")
  medicineReviewDecisions   MedicineReminder[] @relation("MedicineReviewedByDoctor")

  patientMedicineReviewRequests MedicineReviewRequest[] @relation("MedicineReviewPatient")
  doctorMedicineReviewRequests  MedicineReviewRequest[] @relation("MedicineReviewAssignedDoctor")
  doctorMedicineReviewDecisions MedicineReviewRequest[] @relation("MedicineReviewDecisionDoctor")

  patientPrescriptions      Prescription[] @relation("PatientPrescriptions")
  doctorPrescriptions       Prescription[] @relation("DoctorPrescriptions")
  doctorPrescribedMedicines Medicine[]     @relation("DoctorPrescribedMedicines")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phoneNumber       String
  dateOfBirth       DateTime
  gender            Gender?
  medicalConditions String?
  emergencyContact  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  phoneNumber     String
  gmcNumber       String  @unique
  specialization  String
  clinicName      String
  clinicAddress   String?
  yearsExperience Int?
  bio             String?

  gmcDocumentUrl           String
  photoIdDocumentUrl       String
  qualificationDocumentUrl String

  verificationCheckedAt DateTime?
  verificationNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gmcNumber])
  @@index([specialization])
}

model PatientDoctorAssignment {
  id             String                        @id @default(uuid())
  patientId      String
  doctorId       String
  assignmentType DoctorAssignmentType          @default(SPECIALIST)
  status         PatientDoctorAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation("PatientDoctorAssignments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorPatientAssignments", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([patientId, assignmentType])
}

model Prescription {
  id                   String             @id @default(uuid())
  patientId            String
  prescribedByDoctorId String
  source               PrescriptionSource @default(MANUAL)
  imageUrl             String?
  rawDetectedText      String?
  ocrConfidence        Float?
  notes                String?
  prescribedAt         DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  patient            User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  prescribedByDoctor User               @relation("DoctorPrescriptions", fields: [prescribedByDoctorId], references: [id], onDelete: Restrict)
  items              PrescriptionItem[]

  @@index([patientId])
  @@index([prescribedByDoctorId])
  @@index([source])
  @@index([prescribedAt])
}

model PrescriptionItem {
  id                  String            @id @default(uuid())
  prescriptionId      String
  medicineId          String?           @unique
  name                String
  dose                String
  instructions        String?
  frequency           MedicineFrequency
  customFrequency     String?
  selectedTimes       String[]
  startDate           DateTime
  endDate             DateTime?
  prescriptionPattern String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([medicineId])
  @@index([startDate])
}

model Medicine {
  id                   String         @id @default(uuid())
  patientId            String
  prescribedByDoctorId String?
  name                 String
  dose                 String
  instructions         String?
  source               MedicineSource @default(MANUAL)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  patient            User                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedByDoctor User?                   @relation("DoctorPrescribedMedicines", fields: [prescribedByDoctorId], references: [id], onDelete: SetNull)
  reminders          MedicineReminder[]
  prescriptionItem   PrescriptionItem?
  reviewRequests     MedicineReviewRequest[]

  @@index([patientId])
  @@index([prescribedByDoctorId])
  @@index([source])
}

model MedicineReminder {
  id                    String               @id @default(uuid())
  medicineId            String
  frequency             MedicineFrequency    @default(ONCE_DAILY)
  customFrequency       String?
  timeOfDay             String
  startDate             DateTime
  endDate               DateTime?
  sendToDoctorForReview Boolean              @default(false)
  reviewStatus          MedicineReviewStatus @default(NOT_REQUESTED)
  reviewDoctorId        String?
  reviewedByDoctorId    String?
  reviewedAt            DateTime?
  reviewNote            String?
  isActive              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  reviewDoctor     User?             @relation("MedicineReviewDoctor", fields: [reviewDoctorId], references: [id], onDelete: SetNull)
  reviewedByDoctor User?             @relation("MedicineReviewedByDoctor", fields: [reviewedByDoctorId], references: [id], onDelete: SetNull)
  doseLogs         MedicineDoseLog[]

  @@index([medicineId])
  @@index([reviewDoctorId])
  @@index([reviewedByDoctorId])
  @@index([reviewStatus])
  @@index([sendToDoctorForReview])
}

model MedicineReviewRequest {
  id                 String                      @id @default(uuid())
  patientId          String
  doctorId           String
  reviewedByDoctorId String?
  medicineId         String
  requestType        MedicineReviewRequestType
  status             MedicineReviewRequestStatus @default(PENDING)
  patientReason      String?
  doctorNote         String?
  reviewedAt         DateTime?
  patientSeenAt      DateTime?
  appliedAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  patient          User     @relation("MedicineReviewPatient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor           User     @relation("MedicineReviewAssignedDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  reviewedByDoctor User?    @relation("MedicineReviewDecisionDoctor", fields: [reviewedByDoctorId], references: [id], onDelete: SetNull)
  medicine         Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([medicineId, requestType, status])
  @@index([reviewedByDoctorId])
  @@index([createdAt])
}

model MedicineDoseLog {
  id           String        @id @default(uuid())
  reminderId   String
  patientId    String
  scheduledFor DateTime
  status       DoseLogStatus @default(PENDING)
  takenAt      DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminder MedicineReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  User             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([patientId])
  @@index([scheduledFor])
}

model PatientVitalReading {
  id           String      @id @default(uuid())
  patientId    String
  heartRate    Int?
  spo2         Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  glucose      Float?
  temperature  Float?
  status       VitalStatus
  source       VitalSource
  deviceSource String?
  recordedAt   DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  safetyAlerts SafetyAlert[]

  @@index([patientId])
  @@index([recordedAt])
  @@index([status])
}

model PatientDoctorNote {
  id        String  @id @default(uuid())
  patientId String
  doctorId  String?
  note      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
}

model MedicineOrder {
  id        String              @id @default(uuid())
  patientId String
  status    MedicineOrderStatus @default(RECEIVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model SafetyAlert {
  id             String            @id @default(uuid())
  patientId      String
  doctorId       String?
  vitalReadingId String?
  status         SafetyAlertStatus @default(ACTIVE)

  reason      String
  timerEndsAt DateTime

  cancelledAt DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User                 @relation("PatientSafetyAlerts", fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User?                @relation("DoctorSafetyAlerts", fields: [doctorId], references: [id], onDelete: SetNull)
  vitalReading PatientVitalReading? @relation(fields: [vitalReadingId], references: [id], onDelete: SetNull)
  consultation Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([vitalReadingId])
  @@index([status])
  @@index([createdAt])
}

model Consultation {
  id            String  @id @default(uuid())
  patientId     String
  doctorId      String?
  safetyAlertId String? @unique

  type   ConsultationType
  status ConsultationStatus @default(PENDING)

  reason        String
  preferredAt   DateTime?
  notes         String?
  doctorName    String?
  rejectionNote String?

  jaasRoomName String

  acceptedAt  DateTime?
  rejectedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     User         @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?        @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: SetNull)
  safetyAlert SafetyAlert? @relation(fields: [safetyAlertId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model MedicineReference {
  id                  String              @id @default(uuid())
  slug                String              @unique
  brandName           String
  genericName         String
  aliases             String[]
  commonStrengths     String[]
  form                String
  category            String
  usedFor             String
  commonSideEffects   String[]
  defaultInstructions String
  defaultFrequency    MedicineFrequency   @default(ONCE_DAILY)
  defaultTimeOfDay    String              @default("08:00")
  safetyLevel         MedicineSafetyLevel @default(STANDARD)
  safetyNote          String

  imageUrl     String?
  imageAltText String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandName])
  @@index([genericName])
  @@index([isActive])
}
