generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  CAREGIVER
  PHARMACY
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  DISABLED
}

enum MedicineSource {
  MANUAL
  SCANNER
  DOCTOR_PRESCRIBED
}

enum MedicineFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  AS_NEEDED
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppLanguage {
  ENGLISH
  HINDI
  GREEK
  HAUSA
  GERMAN
}

enum AppTextSize {
  SMALL
  NORMAL
  LARGE
  EXTRA_LARGE
}

enum MedicineReviewStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum MedicineReviewRequestType {
  ADD
  DELETE
}

enum MedicineReviewRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum DoseLogStatus {
  PENDING
  TAKEN
  MISSED
  SNOOZED
}

enum VitalStatus {
  STABLE
  WARNING
  CRITICAL
}

enum VitalSource {
  HEALTH_CONNECT
  SIMULATED
  MANUAL
}

enum MedicineOrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum SafetyAlertStatus {
  ACTIVE
  CANCELLED
  ESCALATED
  RESOLVED
}

enum ConsultationType {
  EMERGENCY
  MANUAL
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MedicineSafetyLevel {
  STANDARD
  DOCTOR_REVIEW_RECOMMENDED
}

enum PatientDoctorAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum DoctorAssignmentType {
  PRIMARY
  SPECIALIST
}

enum DoctorOperationalStatus {
  AVAILABLE
  OUT_OF_OFFICE
  UNAVAILABLE
}

enum DoctorAvailabilityStatus {
  AVAILABLE
  OUT_OF_OFFICE
  UNAVAILABLE
}

enum PrescriptionSource {
  MANUAL
  SCANNED
}

enum PatientReportCategory {
  BLOOD_TEST
  SCAN_XRAY
  PRESCRIPTION
  DISCHARGE_SUMMARY
  MEDICAL_LETTER
  OTHER_MEDICAL_REPORT
}

enum PatientReportStatus {
  PENDING_REVIEW
  PARTIALLY_REVIEWED
  REVIEWED
}

enum PatientReportReviewStatus {
  PENDING
  REVIEWED
}

enum PatientReportContentSafetyStatus {
  NOT_SCANNED
  CLEAR
  REVIEW_REQUIRED
  BLOCKED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationPushStatus {
  PENDING
  SENT
  PARTIAL
  FAILED
  SKIPPED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationType {
  SYSTEM_TEST
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  DOCTOR_VERIFICATION_REQUESTED
  PHARMACY_VERIFICATION_REQUESTED
  SAFETY_ALERT_CREATED
  SAFETY_ALERT_ESCALATED
  SAFETY_ALERT_RESOLVED
  CRITICAL_VITAL_DETECTED
  EMERGENCY_CONSULTATION_REQUESTED
  MANUAL_CONSULTATION_REQUESTED
  CONSULTATION_ACCEPTED
  CONSULTATION_REJECTED
  CONSULTATION_COMPLETED
  CONSULTATION_CANCELLED
  PATIENT_JOINED_CALL
  MEDICINE_REVIEW_REQUESTED
  MEDICINE_REVIEW_APPROVED
  MEDICINE_REVIEW_REJECTED
  NEW_PRESCRIPTION
  PATIENT_REPORT_UPLOADED
  REPORT_REVIEWED
  PATIENT_ASSIGNED
  PATIENT_UNASSIGNED
  PRIMARY_DOCTOR_CHANGED
  MEDICINE_REMINDER_DUE
  MEDICINE_REMINDER_SNOOZED
  MISSED_DOSE_ALERT
  REPEATED_MISSED_DOSE
  NEW_MEDICINE_ORDER
  ORDER_RECEIVED
  ORDER_PREPARING
  ORDER_READY
  ORDER_DELIVERED
  ORDER_CANCELLED
}

model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  passwordHash    String
  role            UserRole
  accountStatus   AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)

  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?

  patientProfile           PatientProfile?
  notificationPreferences  PatientNotificationPreference?
  reminderPreferences      PatientReminderPreference?
  safetyPreferences        PatientSafetyPreference?
  accessibilityPreferences PatientAccessibilityPreference?
  privacyPreferences       PatientPrivacyPreference?
  doctorProfile            DoctorProfile?
  doctorAvailabilities     DoctorAvailability[]            @relation("DoctorAvailabilities")

  medicines        Medicine[]
  medicineDoseLogs MedicineDoseLog[]
  vitalReadings    PatientVitalReading[]
  doctorNotes      PatientDoctorNote[]
  medicineOrders   MedicineOrder[]

  patientSafetyAlerts SafetyAlert[] @relation("PatientSafetyAlerts")
  doctorSafetyAlerts  SafetyAlert[] @relation("DoctorSafetyAlerts")

  patientConsultations     Consultation[]            @relation("PatientConsultations")
  doctorConsultations      Consultation[]            @relation("DoctorConsultations")
  patientDoctorAssignments PatientDoctorAssignment[] @relation("PatientDoctorAssignments")
  doctorPatientAssignments PatientDoctorAssignment[] @relation("DoctorPatientAssignments")

  medicineReviewAssignments MedicineReminder[] @relation("MedicineReviewDoctor")
  medicineReviewDecisions   MedicineReminder[] @relation("MedicineReviewedByDoctor")

  patientMedicineReviewRequests MedicineReviewRequest[] @relation("MedicineReviewPatient")
  doctorMedicineReviewRequests  MedicineReviewRequest[] @relation("MedicineReviewAssignedDoctor")
  doctorMedicineReviewDecisions MedicineReviewRequest[] @relation("MedicineReviewDecisionDoctor")

  patientPrescriptions      Prescription[] @relation("PatientPrescriptions")
  doctorPrescriptions       Prescription[] @relation("DoctorPrescriptions")
  doctorPrescribedMedicines Medicine[]     @relation("DoctorPrescribedMedicines")

  patientReports      PatientReport[]       @relation("PatientReports")
  doctorReportReviews PatientReportReview[] @relation("DoctorReportReviews")

  actorAuditLogs   AuditLog[] @relation("ActorAuditLogs")
  patientAuditLogs AuditLog[] @relation("PatientAuditLogs")

  deviceTokens  DeviceToken[]
  notifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  phoneNumber           String
  dateOfBirth           DateTime
  gender                Gender?
  healthRecordNumber    String?  @unique
  medicalConditions     String?
  allergies             String?
  bloodGroup            String?
  addressLine           String?
  postcode              String?
  emergencyContact      String
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([healthRecordNumber])
}

model PatientNotificationPreference {
  id                    String   @id @default(uuid())
  patientId             String   @unique
  medicineReminders     Boolean  @default(true)
  missedDoseAlerts      Boolean  @default(true)
  consultationUpdates   Boolean  @default(true)
  medicineReviewUpdates Boolean  @default(true)
  reportReviewUpdates   Boolean  @default(true)
  criticalVitalAlerts   Boolean  @default(true)
  safetyResponseAlerts  Boolean  @default(true)
  careTeamUpdates       Boolean  @default(true)
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientReminderPreference {
  id                    String   @id @default(uuid())
  patientId             String   @unique
  defaultSnoozeMinutes  Int      @default(10)
  missedDoseReminder    Boolean  @default(true)
  repeatMissedDoseAlert Boolean  @default(true)
  repeatIntervalMinutes Int      @default(30)
  vibrationEnabled      Boolean  @default(true)
  soundEnabled          Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientSafetyPreference {
  id                            String   @id @default(uuid())
  patientId                     String   @unique
  countdownSeconds              Int      @default(30)
  notifyAssignedDoctors         Boolean  @default(true)
  shareLatestVitalsOnEscalation Boolean  @default(true)
  notifyEmergencyContact        Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientAccessibilityPreference {
  id                       String      @id @default(uuid())
  patientId                String      @unique
  language                 AppLanguage @default(ENGLISH)
  textSize                 AppTextSize @default(NORMAL)
  highContrastEnabled      Boolean     @default(false)
  reduceMotionEnabled      Boolean     @default(false)
  screenReaderHintsEnabled Boolean     @default(true)
  hapticFeedbackEnabled    Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientPrivacyPreference {
  id                                String   @id @default(uuid())
  patientId                         String   @unique
  shareVitalsWithAssignedDoctors    Boolean  @default(true)
  shareMedicinesWithAssignedDoctors Boolean  @default(true)
  shareReportsWithAssignedDoctors   Boolean  @default(true)
  hideSensitiveNotificationContent  Boolean  @default(true)
  loginAlertsEnabled                Boolean  @default(true)
  sessionTimeoutMinutes             Int      @default(30)
  confirmBeforeReportSharing        Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model DoctorProfile {
  id              String  @id @default(uuid())
  userId          String  @unique
  phoneNumber     String
  gmcNumber       String  @unique
  specialization  String
  clinicName      String
  clinicAddress   String?
  yearsExperience Int?
  bio             String?

  gmcDocumentUrl           String
  photoIdDocumentUrl       String
  qualificationDocumentUrl String

  verificationCheckedAt DateTime?
  verificationNotes     String?

  operationalStatus DoctorOperationalStatus @default(AVAILABLE)
  statusFrom        DateTime?
  statusUntil       DateTime?
  statusNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gmcNumber])
  @@index([specialization])
  @@index([operationalStatus])
}

model DoctorAvailability {
  id                  String                   @id @default(uuid())
  doctorId            String
  date                DateTime                 @db.Date
  status              DoctorAvailabilityStatus @default(AVAILABLE)
  startTime           String?
  endTime             String?
  slotDurationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor User @relation("DoctorAvailabilities", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, date])
  @@index([doctorId, date])
  @@index([doctorId, status])
}

model PatientDoctorAssignment {
  id             String                        @id @default(uuid())
  patientId      String
  doctorId       String
  assignmentType DoctorAssignmentType          @default(SPECIALIST)
  status         PatientDoctorAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation("PatientDoctorAssignments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorPatientAssignments", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([patientId, assignmentType])
}

model Prescription {
  id                   String             @id @default(uuid())
  patientId            String
  prescribedByDoctorId String
  source               PrescriptionSource @default(MANUAL)
  imageUrl             String?
  rawDetectedText      String?
  ocrConfidence        Float?
  notes                String?
  prescribedAt         DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  patient            User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  prescribedByDoctor User               @relation("DoctorPrescriptions", fields: [prescribedByDoctorId], references: [id], onDelete: Restrict)
  items              PrescriptionItem[]

  @@index([patientId])
  @@index([prescribedByDoctorId])
  @@index([source])
  @@index([prescribedAt])
}

model PrescriptionItem {
  id                  String            @id @default(uuid())
  prescriptionId      String
  medicineId          String?           @unique
  name                String
  dose                String
  instructions        String?
  frequency           MedicineFrequency
  customFrequency     String?
  selectedTimes       String[]
  startDate           DateTime
  endDate             DateTime?
  prescriptionPattern String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@index([medicineId])
  @@index([startDate])
}

model PatientReport {
  id          String                @id @default(uuid())
  patientId   String
  title       String
  category    PatientReportCategory
  description String?
  reportDate  DateTime?
  status      PatientReportStatus   @default(PENDING_REVIEW)

  originalFileName String
  storedFileName   String @unique
  mimeType         String
  fileSize         Int
  fileHash         String

  contentSafetyStatus    PatientReportContentSafetyStatus @default(NOT_SCANNED)
  contentSafetyMessage   String?
  contentSafetyCheckedAt DateTime?

  isSampleDataConfirmed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User                  @relation("PatientReports", fields: [patientId], references: [id], onDelete: Cascade)
  reviews PatientReportReview[]

  @@unique([patientId, fileHash])
  @@index([patientId, status])
  @@index([patientId, createdAt])
  @@index([category])
  @@index([contentSafetyStatus])
}

model PatientReportReview {
  id            String                    @id @default(uuid())
  reportId      String
  doctorId      String
  status        PatientReportReviewStatus @default(PENDING)
  reviewNote    String?
  reviewedAt    DateTime?
  patientSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report PatientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  doctor User          @relation("DoctorReportReviews", fields: [doctorId], references: [id], onDelete: Restrict)

  @@unique([reportId, doctorId])
  @@index([doctorId, status])
  @@index([reportId, status])
  @@index([reviewedAt])
}

model Medicine {
  id                   String         @id @default(uuid())
  patientId            String
  prescribedByDoctorId String?
  name                 String
  dose                 String
  instructions         String?
  source               MedicineSource @default(MANUAL)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  patient            User                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedByDoctor User?                   @relation("DoctorPrescribedMedicines", fields: [prescribedByDoctorId], references: [id], onDelete: SetNull)
  reminders          MedicineReminder[]
  prescriptionItem   PrescriptionItem?
  reviewRequests     MedicineReviewRequest[]

  @@index([patientId])
  @@index([prescribedByDoctorId])
  @@index([source])
}

model MedicineReminder {
  id                    String               @id @default(uuid())
  medicineId            String
  frequency             MedicineFrequency    @default(ONCE_DAILY)
  customFrequency       String?
  timeOfDay             String
  startDate             DateTime
  endDate               DateTime?
  sendToDoctorForReview Boolean              @default(false)
  reviewStatus          MedicineReviewStatus @default(NOT_REQUESTED)
  reviewDoctorId        String?
  reviewedByDoctorId    String?
  reviewedAt            DateTime?
  reviewNote            String?
  isActive              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  reviewDoctor     User?             @relation("MedicineReviewDoctor", fields: [reviewDoctorId], references: [id], onDelete: SetNull)
  reviewedByDoctor User?             @relation("MedicineReviewedByDoctor", fields: [reviewedByDoctorId], references: [id], onDelete: SetNull)
  doseLogs         MedicineDoseLog[]

  @@index([medicineId])
  @@index([reviewDoctorId])
  @@index([reviewedByDoctorId])
  @@index([reviewStatus])
  @@index([sendToDoctorForReview])
}

model MedicineReviewRequest {
  id                 String                      @id @default(uuid())
  patientId          String
  doctorId           String
  reviewedByDoctorId String?
  medicineId         String
  requestType        MedicineReviewRequestType
  status             MedicineReviewRequestStatus @default(PENDING)
  patientReason      String?
  doctorNote         String?
  reviewedAt         DateTime?
  patientSeenAt      DateTime?
  appliedAt          DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  patient          User     @relation("MedicineReviewPatient", fields: [patientId], references: [id], onDelete: Cascade)
  doctor           User     @relation("MedicineReviewAssignedDoctor", fields: [doctorId], references: [id], onDelete: Restrict)
  reviewedByDoctor User?    @relation("MedicineReviewDecisionDoctor", fields: [reviewedByDoctorId], references: [id], onDelete: SetNull)
  medicine         Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([medicineId, requestType, status])
  @@index([reviewedByDoctorId])
  @@index([createdAt])
}

model MedicineDoseLog {
  id           String        @id @default(uuid())
  reminderId   String
  patientId    String
  scheduledFor DateTime
  status       DoseLogStatus @default(PENDING)
  takenAt      DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminder MedicineReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  User             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([patientId])
  @@index([scheduledFor])
}

model PatientVitalReading {
  id           String      @id @default(uuid())
  patientId    String
  heartRate    Int?
  spo2         Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  glucose      Float?
  temperature  Float?
  status       VitalStatus
  source       VitalSource
  deviceSource String?
  recordedAt   DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  safetyAlerts SafetyAlert[]

  @@index([patientId])
  @@index([recordedAt])
  @@index([status])
}

model PatientDoctorNote {
  id        String  @id @default(uuid())
  patientId String
  doctorId  String?
  note      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
}

model MedicineOrder {
  id        String              @id @default(uuid())
  patientId String
  status    MedicineOrderStatus @default(RECEIVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model SafetyAlert {
  id             String            @id @default(uuid())
  patientId      String
  doctorId       String?
  vitalReadingId String?
  status         SafetyAlertStatus @default(ACTIVE)

  reason      String
  timerEndsAt DateTime

  cancelledAt DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User                 @relation("PatientSafetyAlerts", fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User?                @relation("DoctorSafetyAlerts", fields: [doctorId], references: [id], onDelete: SetNull)
  vitalReading PatientVitalReading? @relation(fields: [vitalReadingId], references: [id], onDelete: SetNull)
  consultation Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([vitalReadingId])
  @@index([status])
  @@index([createdAt])
}

model Consultation {
  id            String  @id @default(uuid())
  patientId     String
  doctorId      String?
  safetyAlertId String? @unique

  type   ConsultationType
  status ConsultationStatus @default(PENDING)

  reason        String
  preferredAt   DateTime?
  notes         String?
  doctorName    String?
  rejectionNote String?

  jaasRoomName String

  acceptedAt  DateTime?
  rejectedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     User         @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?        @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: SetNull)
  safetyAlert SafetyAlert? @relation(fields: [safetyAlertId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model MedicineReference {
  id                  String              @id @default(uuid())
  slug                String              @unique
  brandName           String
  genericName         String
  aliases             String[]
  commonStrengths     String[]
  form                String
  category            String
  usedFor             String
  commonSideEffects   String[]
  defaultInstructions String
  defaultFrequency    MedicineFrequency   @default(ONCE_DAILY)
  defaultTimeOfDay    String              @default("08:00")
  safetyLevel         MedicineSafetyLevel @default(STANDARD)
  safetyNote          String

  imageUrl     String?
  imageAltText String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandName])
  @@index([genericName])
  @@index([isActive])
}

model AuditLog {
  id String @id @default(uuid())

  actorId   String?
  actorRole String

  action     String
  entityType String
  entityId   String?

  patientId   String?
  outcome     AuditOutcome @default(SUCCESS)
  description String
  metadata    Json?

  requestMethod String?
  requestPath   String?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())

  actor   User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  patient User? @relation("PatientAuditLogs", fields: [patientId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([actorRole, createdAt])
  @@index([patientId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([outcome, createdAt])
  @@index([createdAt])
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  deviceId   String?
  deviceName String?
  appVersion String?
  isActive   Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isActive])
  @@index([userId, platform])
  @@index([lastSeenAt])
}

model UserNotification {
  id            String                 @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  body          String
  priority      NotificationPriority   @default(NORMAL)
  entityType    String?
  entityId      String?
  targetScreen  String?
  data          Json?
  isRead        Boolean                @default(false)
  readAt        DateTime?
  pushStatus    NotificationPushStatus @default(PENDING)
  sentAt        DateTime?
  failureReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
  @@index([entityType, entityId])
  @@index([pushStatus, createdAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid())
  notificationId    String
  deviceTokenId     String
  status            NotificationDeliveryStatus @default(PENDING)
  firebaseMessageId String?
  failureCode       String?
  failureReason     String?
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deviceToken  DeviceToken      @relation(fields: [deviceTokenId], references: [id], onDelete: Restrict)

  @@unique([notificationId, deviceTokenId])
  @@index([deviceTokenId, createdAt])
  @@index([status, createdAt])
}
