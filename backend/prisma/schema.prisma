generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  CAREGIVER
  PHARMACY
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  DISABLED
}

enum MedicineSource {
  MANUAL
  SCANNER
  DOCTOR_PRESCRIBED
}

enum MedicineFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  FOUR_TIMES_DAILY
  AS_NEEDED
  CUSTOM
}

enum MedicineReviewStatus {
  NOT_REQUESTED
  PENDING
  APPROVED
  REJECTED
}

enum DoseLogStatus {
  PENDING
  TAKEN
  MISSED
  SNOOZED
}

enum VitalStatus {
  STABLE
  WARNING
  CRITICAL
}

enum VitalSource {
  HEALTH_CONNECT
  SIMULATED
  MANUAL
}

enum MedicineOrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum SafetyAlertStatus {
  ACTIVE
  CANCELLED
  ESCALATED
  RESOLVED
}

enum ConsultationType {
  EMERGENCY
  MANUAL
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  passwordHash    String
  role            UserRole
  accountStatus   AccountStatus @default(ACTIVE)
  isEmailVerified Boolean       @default(false)

  emailVerificationToken          String?
  emailVerificationTokenExpiresAt DateTime?

  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?

  patientProfile   PatientProfile?
  medicines        Medicine[]
  medicineDoseLogs MedicineDoseLog[]
  vitalReadings    PatientVitalReading[]
  doctorNotes      PatientDoctorNote[]
  medicineOrders   MedicineOrder[]

  patientSafetyAlerts SafetyAlert[] @relation("PatientSafetyAlerts")
  doctorSafetyAlerts  SafetyAlert[] @relation("DoctorSafetyAlerts")

  patientConsultations Consultation[] @relation("PatientConsultations")
  doctorConsultations  Consultation[] @relation("DoctorConsultations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  phoneNumber       String
  dateOfBirth       DateTime
  medicalConditions String?
  emergencyContact  String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Medicine {
  id           String         @id @default(uuid())
  patientId    String
  name         String
  dose         String
  instructions String?
  source       MedicineSource @default(MANUAL)
  isActive     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   User               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reminders MedicineReminder[]

  @@index([patientId])
}

model MedicineReminder {
  id                    String               @id @default(uuid())
  medicineId            String
  frequency             MedicineFrequency    @default(ONCE_DAILY)
  customFrequency       String?
  timeOfDay             String
  startDate             DateTime
  endDate               DateTime?
  sendToDoctorForReview Boolean              @default(false)
  reviewStatus          MedicineReviewStatus @default(NOT_REQUESTED)
  isActive              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicine Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  doseLogs MedicineDoseLog[]

  @@index([medicineId])
}

model MedicineDoseLog {
  id           String        @id @default(uuid())
  reminderId   String
  patientId    String
  scheduledFor DateTime
  status       DoseLogStatus @default(PENDING)
  takenAt      DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminder MedicineReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  patient  User             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([patientId])
  @@index([scheduledFor])
}

model PatientVitalReading {
  id           String      @id @default(uuid())
  patientId    String
  heartRate    Int?
  spo2         Int?
  bpSystolic   Int?
  bpDiastolic  Int?
  glucose      Float?
  temperature  Float?
  status       VitalStatus
  source       VitalSource
  deviceSource String?
  recordedAt   DateTime    @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  safetyAlerts SafetyAlert[]

  @@index([patientId])
  @@index([recordedAt])
  @@index([status])
}

model PatientDoctorNote {
  id        String @id @default(uuid())
  patientId String
  note      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
}

model MedicineOrder {
  id        String              @id @default(uuid())
  patientId String
  status    MedicineOrderStatus @default(RECEIVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
}

model SafetyAlert {
  id             String            @id @default(uuid())
  patientId      String
  doctorId       String?
  vitalReadingId String?
  status         SafetyAlertStatus @default(ACTIVE)

  reason      String
  timerEndsAt DateTime

  cancelledAt DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient      User                 @relation("PatientSafetyAlerts", fields: [patientId], references: [id], onDelete: Cascade)
  doctor       User?                @relation("DoctorSafetyAlerts", fields: [doctorId], references: [id], onDelete: SetNull)
  vitalReading PatientVitalReading? @relation(fields: [vitalReadingId], references: [id], onDelete: SetNull)
  consultation Consultation?

  @@index([patientId])
  @@index([doctorId])
  @@index([vitalReadingId])
  @@index([status])
  @@index([createdAt])
}

model Consultation {
  id            String  @id @default(uuid())
  patientId     String
  doctorId      String?
  safetyAlertId String? @unique

  type   ConsultationType
  status ConsultationStatus @default(PENDING)

  reason        String
  preferredAt   DateTime?
  notes         String?
  doctorName    String?
  rejectionNote String?

  jaasRoomName String

  acceptedAt  DateTime?
  rejectedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     User         @relation("PatientConsultations", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      User?        @relation("DoctorConsultations", fields: [doctorId], references: [id], onDelete: SetNull)
  safetyAlert SafetyAlert? @relation(fields: [safetyAlertId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
